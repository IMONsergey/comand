# Add a separate virtual host; replace hostname and TLS paths.
server {
    listen 443 ssl;
    server_name comand.example.com;
    ssl_certificate /etc/letsencrypt/live/comand.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/comand.example.com/privkey.pem;
    client_max_body_size 5m;
    location / {
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
    }
}
